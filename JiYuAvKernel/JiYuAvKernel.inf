; JiYu AV x64 kernel service package.

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ManufacturerName%
CatalogFile=JiYuAvKernel.cat
DriverVer=
PnpLockDown=1

[DestinationDirs]
DefaultDestDir=13
DriverCopyFiles=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
JiYuAvKernel.sys=1,,

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=JiYuAvKernel,0x00000002,JiYuAvKernel_Service

[DriverCopyFiles]
JiYuAvKernel.sys

[JiYuAvKernel_Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\JiYuAvKernel.sys

[Strings]
ManufacturerName="JiYu AV"
DiskName="JiYu AV Kernel Installation Disk"
ServiceDescription="JiYu AV Kernel Scanner"
