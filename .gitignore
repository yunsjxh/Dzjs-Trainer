# ---------------------------------------------------------------------------
# Update channel
# ---------------------------------------------------------------------------
# The real public key is generated by tools/make-ticket-key.py. The repository
# ships UpdaterTicketKey.h.example instead, so a clone cannot pretend to be an
# official client. The public key is not a secret; keeping it out is about not
# handing out a build that talks to the production update server.
/DzjsTrainerUpdater/UpdaterTicketKey.h

