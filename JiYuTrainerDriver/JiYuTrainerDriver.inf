; JiYuTrainer x64 non-PnP control driver package.

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ManufacturerName%
CatalogFile=JiYuTrainerDriver.cat
DriverVer=
PnpLockDown=1

[DestinationDirs]
DefaultDestDir=13
DriverCopyFiles=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
JiYuTrainerDriver.sys=1,,

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=JiYuTrainerDriver,0x00000002,JiYuTrainerDriver_Service

[DriverCopyFiles]
JiYuTrainerDriver.sys

[JiYuTrainerDriver_Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\JiYuTrainerDriver.sys

[Strings]
ManufacturerName="JiYuTrainer"
DiskName="JiYuTrainer Driver Installation Disk"
ServiceDescription="JiYuTrainer x64 Kernel Driver"
